#1.1 a) funcao ler_linhas(nome)
def ler_linhas(nome):
    linhas = [] #lista de linhas
    with open(nome, 'r', encoding = 'utf-8') as f: #abrir ficheiro com codificacao utf-8
        for linha in f:
            if linha[-1] == "\n": #se na linha, o ultimo elemento ser \n
                linha = linha[:-1] #obtem todos os caracteres exceto o ultimo
            linhas.append(linha)

    return linhas


#1.1 b)
def extrair_corpo(linhas):
    inicio = 0
    fim = len(linhas)

    for i in range(len(linhas)):
        if linhas[i][:12] == "*** START OF":
            inicio=i+1 #começar na linha seguinte do marcador

        if linhas[i][:10] == "*** END OF":
            fim=i

    return linhas[inicio:fim]

    
# 1.1 c)
def contar_linhas(corpo):
    numero_linhas = len(corpo) #corpo é uma lista em que cada elemente corresponde a uma linha do texto
    print("Número de linhas:", numero_linhas)

def contar_caracteres(corpo):
    numero_caracteres = 0

    for linha in corpo:
        numero_caracteres += len(linha)

    print("Número de caracteres:", numero_caracteres)


# 1.2
def tokenizar(texto):
    texto = texto.lower() # texto convertido para minusculas
    palavra = "" # sequencia de letras para depois construir uma palavra
    tokens = [] #lista vazia , para depois guardar as palavras 

    for i in range(len(texto)): # percorre o texto 1 caracter de cada vez
        caracter = texto[i] # guarda caracter na posicao i

        if caracter.isalpha(): #se caracter for string
            palavra = palavra + caracter #juntas caracteres para formar palavra

        elif caracter == "-" or caracter == "'": #se caracter for hifen ou apostrofo
            if i > 0 and (i < len(texto) - 1): # verifica se existe caracter antes e depois
                # ex: disse-lhe
                if texto[i-1].isalpha() and texto[i+1].isalpha(): # se o caracter antes e depois forem letars
                    palavra = palavra + caracter #juntar o simbolo à palavra

                else:
                    if palavra != "": #se palavra nao for vazia
                        tokens.append(palavra) #adiciona para a lista token
                        palavra = "" # deixar vazia, se nao a proxima palavra seria acrescentada 
            else:
                if palavra != "": #se palavra nao for vazia
                    tokens.append(palavra) #adiciona para a lista token
                    palavra = "" # deixar vazia, se nao a proxima palavra seria acrescentada 

        else: # se o caracter nao for letra, hifen ou apostrofo
            if palavra != "": #se a palavra nao for vazia
                tokens.append(palavra) 
                palavra="" 

            if caracter == "." or caracter == "!" or caracter == "?": #se for pontuacao
                if i == 0 or texto[i-1] not in ".!?": # se for o primeiro caracter ou a anterior nao for pontuacao
                    tokens.append(caracter) #adiciona a pontuacao a lista

    if palavra != "": # se ainda existir uma palavra depois do ciclo
        tokens.append(palavra)

    return tokens


# 1.3
def contar_frequencias(tokens):
    frequencias = {}

    for token in tokens: # lista de tokens 1 de cada vez
        if token in frequencias: # se token já existir no dicionario, ou seja se vai repetir
            frequencias[token] += 1 # aumenta em 1
        else:
            frequencias[token] = 1 # se é a primeira vez a receber entao adiciona 1

    return frequencias 

# 1.4
def top_n(freqs, n):
    lista = list(freqs.items()) # transforma dicionario em lista de tuplos (token, frequencia)
    lista.sort(key=lambda x: x[1], reverse=True) # ordena a lista com base na frequencia (x[1]) do maior para o menor
    return lista[:n] # devolve os n primeiros elementos da lista



